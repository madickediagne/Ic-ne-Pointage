# ─── Base de données ───────────────────────────────────────────────────────
# URL de connexion PostgreSQL (Neon en production, local en développement)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# ─── Auth.js ───────────────────────────────────────────────────────────────
# Secret pour signer les tokens de session (générer avec : openssl rand -base64 32)
AUTH_SECRET="VOTRE_SECRET_ICI"
NEXTAUTH_URL="http://localhost:3000"

# ─── Application ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Icône Pointage"

# ─── QR Code ───────────────────────────────────────────────────────────────
# Clé secrète pour signer les QR Codes (générer avec : openssl rand -base64 32)
QR_SECRET="VOTRE_QR_SECRET_ICI"

# ─── Géolocalisation ───────────────────────────────────────────────────────
# Rayon GPS par défaut en mètres
NEXT_PUBLIC_DEFAULT_RADIUS=50
# Précision GPS maximale acceptée en mètres
NEXT_PUBLIC_MAX_GPS_ACCURACY=100
